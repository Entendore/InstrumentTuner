<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg" android:orientation="vertical"
    android:gravity="center" android:padding="14dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="🎵 INSTRUMENT TUNER" android:textColor="#8E8E93"
        android:textSize="10sp" android:letterSpacing="0.15" />
    <TextView android:id="@+id/widget_instrument" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:text="Guitar" android:textColor="#FFFFFF"
        android:textSize="20sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/widget_sub" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:text="tap to tune"
        android:textColor="#34C759" android:textSize="11sp" />
</LinearLayout>
